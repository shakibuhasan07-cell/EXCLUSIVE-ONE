# Strong random secret in production
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0

# Admin account (change these before public deployment)
ADMIN_EMAIL=admin@exclusive-one.local
ADMIN_PASSWORD=ChangeMe123!

# Optional SMTP support for password-reset and contact emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
